add_trace(data = d, x = ~AGNO_FALLO, y = ~monto_prom,
type = "scatter", mode = "lines+markers", name = g,
hovertemplate = paste0("<b>", g, "</b><br>",
"Año: %{x}<br>",
"Monto prom.: $%{y:,.0f}",
"<extra></extra>"))
}
